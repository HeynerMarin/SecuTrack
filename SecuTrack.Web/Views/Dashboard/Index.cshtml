@{
    ViewData["Title"] = "Dashboard de Cumplimiento";
    var providers = ViewBag.Providers as IEnumerable<SecuTrack.Application.DTOs.ProviderDto>;
}

<div class="container-fluid py-4 fade-in">
    <!-- Encabezado -->
    <div class="row mb-4">
        <div class="col-12 text-center text-md-start">
            <h1 class="fw-bold text-primary-dark">
                <i class="bi bi-bar-chart-line-fill me-2"></i> Dashboard de Cumplimiento ISO/IEC 27002
            </h1>
            <p class="text-muted mb-0">Análisis comparativo y métricas de auditorías en servicios cloud</p>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-6 col-lg-4 mb-3 mb-md-0">
                    <label class="form-label fw-semibold text-secondary">Seleccionar Proveedor (Histórico)</label>
                    <select id="providerSelect" class="form-select shadow-sm">
                        <option value="">-- Seleccione un proveedor --</option>
                        @foreach (var provider in providers)
                        {
                            <option value="@provider.Id">@provider.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-lg-8 text-end">
                    <button class="btn btn-gradient-secutrack shadow-sm" onclick="refreshCharts()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Gráficos
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos Principales -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card chart-card border-0 shadow-sm">
                <div class="card-header bg-gradient-secutrack text-white rounded-top-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-bar-chart-fill me-2"></i>Comparación Global por Proveedor</h5>
                </div>
                <div class="card-body"><canvas id="comparisonChart" height="300"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card chart-card border-0 shadow-sm">
                <div class="card-header bg-success text-white rounded-top-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-pie-chart-fill me-2"></i>Distribución de Niveles de Cumplimiento</h5>
                </div>
                <div class="card-body"><canvas id="distributionChart" height="300"></canvas></div>
            </div>
        </div>
    </div>

    <!-- Segunda fila de gráficos -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card chart-card border-0 shadow-sm">
                <div class="card-header bg-info text-white rounded-top-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-diagram-3-fill me-2"></i>Desglose por Categoría ISO 27002</h5>
                </div>
                <div class="card-body">
                    <canvas id="categoryChart" height="300"></canvas>
                    <div class="text-center mt-3">
                        <small class="text-muted">Selecciona un proveedor arriba para ver el desglose</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card chart-card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark rounded-top-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Brechas Críticas por Proveedor</h5>
                </div>
                <div class="card-body"><canvas id="gapsChart" height="300"></canvas></div>
            </div>
        </div>
    </div>

    <!-- Histórico dinámico -->
    <div class="row mb-4" id="historyRow" style="display: none;">
        <div class="col-12">
            <div class="card chart-card border-0 shadow-sm">
                <div class="card-header bg-dark text-white rounded-top-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-clock-history me-2"></i>Histórico de Cumplimiento</h5>
                </div>
                <div class="card-body"><canvas id="historyChart" height="120"></canvas></div>
            </div>
        </div>
    </div>

    <!-- Radar -->
    <div class="row">
        <div class="col-12">
            <div class="card chart-card border-0 shadow-sm">
                <div class="card-header bg-secondary text-white rounded-top-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-bezier me-2"></i>Radar de Cumplimiento por Categorías</h5>
                </div>
                <div class="card-body"><canvas id="radarChart" height="120"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
