@using Microsoft.AspNetCore.Mvc.Rendering
@{
    string IsActive(string controllerName, string actionName = "Index")
    {
        string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "Home";
        return currentController.Equals(controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecuTrack</title>

    <!-- 🔷 ICONOS Y FUENTES -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- 🔷 BOOTSTRAP -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-light-secutrack d-flex flex-column min-vh-100">

    <!-- 🔷 NAVBAR -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-secutrack py-3 px-3">
            <div class="container-fluid">

                <!-- Marca -->
                <a class="navbar-brand fw-bold fs-4 text-white d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-lock-fill me-2 fs-3"></i> SecuTrack
                </a>

                <!-- Botón responsive -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Enlaces -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-3">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill transition @IsActive("Home")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill transition @IsActive("Providers")" asp-controller="Providers" asp-action="Index">Proveedores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill transition @IsActive("Audits")" asp-controller="Audits" asp-action="Index">Auditorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill transition @IsActive("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- 🔷 CONTENIDO PRINCIPAL -->
    <main class="flex-fill container py-4 fade-in">
        @RenderBody()
    </main>

    <!-- 🔷 FOOTER -->
    <footer class="footer mt-auto py-3 bg-dark text-white text-center small shadow-inner">
        <div class="container">
            &copy; 2025 - <strong>SecuTrack</strong> | Auditoría ISO/IEC 27002
        </div>
    </footer>

    <!-- 🔷 SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
