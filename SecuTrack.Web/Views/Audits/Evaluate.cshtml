@model SecuTrack.Application.DTOs.AuditDetailDto

@{
    ViewData["Title"] = "Evaluar Auditoría";
    var controls = ViewBag.Controls as List<SecuTrack.Core.Entities.ISOControl>;
}

<div class="container-fluid mt-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-9">
            <h1 class="fw-bold text-primary mb-1">Evaluación de Auditoría</h1>
            <p class="lead text-muted mb-0">
                <strong>Proveedor:</strong> @Model.ProviderName |
                <strong>Auditor:</strong> @Model.AuditorName |
                <strong>Fecha:</strong> @Model.AuditDate.ToString("dd/MM/yyyy")
            </p>
        </div>
        <div class="col-md-3 text-end">
            <form asp-action="Complete" asp-route-id="@Model.Id" method="post" id="completeForm">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-success shadow-sm" onclick="confirmComplete()">
                    <i class="bi bi-check-circle me-1"></i> Completar Auditoría
                </button>
            </form>
        </div>
    </div>

    <div class="alert alert-info shadow-sm">
        <i class="bi bi-info-circle me-1"></i>
        Evalúa cada control ISO/IEC 27002 según el nivel de cumplimiento del proveedor.
        <strong>Tus cambios se guardan automáticamente.</strong>
    </div>

    <div class="accordion" id="controlsAccordion">
        @{
            var categories = controls.GroupBy(c => c.Category).OrderBy(g => g.Key);
            int categoryIndex = 0;
        }

        @foreach (var category in categories)
        {
            var categoryName = category.Key.ToString();
            var categoryId = $"category{categoryIndex}";

            <div class="accordion-item shadow-sm mb-3">
                <h2 class="accordion-header" id="heading@(categoryIndex)">
                    <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#@categoryId">
                        @GetCategoryName(category.Key)
                        <span class="badge bg-secondary ms-2">@category.Count() controles</span>
                    </button>
                </h2>
                <div id="@categoryId" class="accordion-collapse collapse" data-bs-parent="#controlsAccordion">
                    <div class="accordion-body bg-light">
                        @foreach (var control in category)
                        {
                            var existingEval = Model.Evaluations.FirstOrDefault(e => e.ISOControlId == control.Id);

                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Control @control.ControlId:</strong> @control.Title
                                        @if (control.IsCritical)
                                        {
                                            <span class="badge bg-danger ms-2">CRÍTICO</span>
                                        }
                                    </div>
                                </div>

                                <div class="card-body">
                                    <p><strong>Propósito:</strong> @control.Purpose</p>
                                    <p><strong>Adaptación Cloud:</strong> @control.CloudAdaptation</p>

                                    <form class="evaluation-form" data-control-id="@control.Id" data-audit-id="@Model.Id">
                                        @Html.AntiForgeryToken()

                                        <div class="row">
                                            <div class="col-md-3">
                                                <label class="form-label fw-semibold">Nivel de Cumplimiento</label>
                                                <select name="ComplianceLevel" class="form-select compliance-level" required>
                                                    <option value="">-- Seleccione --</option>
                                                    @{
                                                        var compliance = existingEval?.ComplianceLevel;
                                                    }
                                                    <option value="0" selected="@(compliance == SecuTrack.Core.Enums.ComplianceLevel.NotImplemented)">No Implementado (0%)</option>
                                                    <option value="25" selected="@(compliance == SecuTrack.Core.Enums.ComplianceLevel.PartiallyImplemented)">Parcialmente (25%)</option>
                                                    <option value="50" selected="@(compliance == SecuTrack.Core.Enums.ComplianceLevel.LargelyImplemented)">Mayormente (50%)</option>
                                                    <option value="75" selected="@(compliance == SecuTrack.Core.Enums.ComplianceLevel.FullyImplemented)">Totalmente (75%)</option>
                                                    <option value="100" selected="@(compliance == SecuTrack.Core.Enums.ComplianceLevel.ExceedsRequirements)">Supera Requisitos (100%)</option>
                                                </select>
                                            </div>

                                            <div class="col-md-9">
                                                <label class="form-label fw-semibold">Evidencia</label>
                                                <input name="Evidence" type="text" class="form-control" placeholder="URLs, documentos o referencias" value="@(existingEval?.Evidence ?? "")" />
                                            </div>
                                        </div>

                                        <div class="row mt-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Notas del Auditor</label>
                                                <textarea name="AuditorNotes" class="form-control" rows="2" placeholder="Observaciones del auditor">@(existingEval?.AuditorNotes ?? "")</textarea>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Recomendaciones</label>
                                                <textarea name="Recommendations" class="form-control" rows="2" placeholder="Acciones o sugerencias de mejora">@(existingEval?.Recommendations ?? "")</textarea>
                                            </div>
                                        </div>

                                        <div class="mt-3 d-flex align-items-center">
                                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-save me-1"></i> Guardar Evaluación
                                            </button>
                                            <span class="save-status ms-3"></span>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            categoryIndex++;
        }
    </div>
</div>

@functions {
    string GetCategoryName(SecuTrack.Core.Enums.ISOCategory category)
    {
        return category switch
        {
            SecuTrack.Core.Enums.ISOCategory.OrganizationalControls => "Controles Organizacionales",
            SecuTrack.Core.Enums.ISOCategory.PeopleControls => "Controles de Personas",
            SecuTrack.Core.Enums.ISOCategory.PhysicalControls => "Controles Físicos",
            SecuTrack.Core.Enums.ISOCategory.TechnologicalControls => "Controles Tecnológicos",
            _ => "Desconocido"
        };
    }
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <script>
        // Auto-save evaluations
        document.querySelectorAll('.evaluation-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const controlId = this.dataset.controlId;
                const auditId = this.dataset.auditId;
                const statusSpan = this.querySelector('.save-status');
                const formData = new FormData(this);

                const data = {
                    AuditSessionId: parseInt(auditId),
                    ISOControlId: parseInt(controlId),
                    ComplianceLevel: parseInt(formData.get('ComplianceLevel')),
                    Evidence: formData.get('Evidence'),
                    AuditorNotes: formData.get('AuditorNotes'),
                    Recommendations: formData.get('Recommendations')
                };

                const token = this.querySelector('input[name="__RequestVerificationToken"]').value;

                try {
                    const response = await fetch('@Url.Action("SaveEvaluation")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (result.success) {
                        statusSpan.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Guardado</span>';
                        setTimeout(() => statusSpan.innerHTML = '', 2500);
                    } else {
                        statusSpan.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle"></i> Error</span>';
                    }
                } catch (error) {
                    statusSpan.innerHTML = '<span class="text-danger"><i class="bi bi-wifi-off"></i> Error de conexión</span>';
                }
            });
        });

        function confirmComplete() {
            if (confirm('¿Deseas completar esta auditoría? Se calculará el score global y no podrás modificar más evaluaciones.')) {
                document.getElementById('completeForm').submit();
            }
        }
    </script>
}
