@model SecuTrack.Application.DTOs.CreateAuditDto

@{
    ViewData["Title"] = "Nueva Auditoría";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-secutrack text-white text-center rounded-top-4">
                    <h3 class="mb-0">
                        <i class="bi bi-clipboard-check me-2"></i> Nueva Auditoría ISO/IEC 27002
                    </h3>
                    <p class="mb-0 small text-white-50">Registra una nueva auditoría para un proveedor de servicios en la nube</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Proveedor -->
                        <div class="mb-3">
                            <label asp-for="ProviderId" class="form-label fw-semibold">
                                <i class="bi bi-cloud me-1 text-primary"></i> Proveedor Cloud
                            </label>
                            <select asp-for="ProviderId" class="form-select shadow-sm" asp-items="ViewBag.Providers">
                                <option value="">-- Seleccione un proveedor --</option>
                            </select>
                            <span asp-validation-for="ProviderId" class="text-danger"></span>
                        </div>

                        <!-- Auditor -->
                        <div class="mb-3">
                            <label asp-for="AuditorName" class="form-label fw-semibold">
                                <i class="bi bi-person-badge me-1 text-primary"></i> Nombre del Auditor
                            </label>
                            <input asp-for="AuditorName" class="form-control shadow-sm" placeholder="Nombre completo del auditor" />
                            <span asp-validation-for="AuditorName" class="text-danger"></span>
                        </div>

                        <!-- Fecha -->
                        <div class="mb-3">
                            <label asp-for="AuditDate" class="form-label fw-semibold">
                                <i class="bi bi-calendar-date me-1 text-primary"></i> Fecha de Auditoría
                            </label>
                            <input asp-for="AuditDate" class="form-control shadow-sm" type="date" />
                            <span asp-validation-for="AuditDate" class="text-danger"></span>
                        </div>

                        <!-- Versión -->
                        <div class="mb-3">
                            <label asp-for="AuditVersion" class="form-label fw-semibold">
                                <i class="bi bi-code-slash me-1 text-primary"></i> Versión
                            </label>
                            <input asp-for="AuditVersion" class="form-control shadow-sm" placeholder="1.0" />
                            <span asp-validation-for="AuditVersion" class="text-danger"></span>
                        </div>

                        <!-- Notas -->
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-semibold">
                                <i class="bi bi-journal-text me-1 text-primary"></i> Notas
                            </label>
                            <textarea asp-for="Notes" class="form-control shadow-sm" rows="3" placeholder="Notas generales de la auditoría"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <!-- Botones -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left-circle"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check2-circle"></i> Crear y Comenzar Evaluación
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
