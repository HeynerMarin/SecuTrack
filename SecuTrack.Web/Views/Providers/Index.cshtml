@model IEnumerable<SecuTrack.Application.DTOs.ProviderDto>

@{
    ViewData["Title"] = "Proveedores Cloud";
}

<div class="container py-4 fade-in">
    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div>
            <h1 class="fw-bold text-primary-dark mb-1">
                <i class="bi bi-cloud-check-fill me-2"></i> Proveedores Cloud
            </h1>
            <p class="text-muted mb-0">Gestiona los proveedores de servicios en la nube y su cumplimiento ISO 27002</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-gradient-secutrack shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nuevo Proveedor
            </a>
        </div>
    </div>

    <!-- Mensaje de éxito -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm animate__animated animate__fadeInDown" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Listado de proveedores -->
    <div class="row">
        @foreach (var provider in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 rounded-4 provider-card h-100">
                    <div class="card-header bg-gradient-secutrack text-white rounded-top-4">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-building me-2"></i> @provider.Name
                        </h5>
                    </div>

                    <div class="card-body">
                        <ul class="list-unstyled mb-3">
                            <li><strong>Tipo:</strong> @provider.TypeDisplay</li>
                            <li><strong>Región:</strong> @provider.Region</li>
                            <li><strong>Auditorías:</strong> @provider.TotalAudits</li>
                        </ul>

                        @if (provider.LastComplianceScore.HasValue)
                        {
                            var score = provider.LastComplianceScore.Value;
                            string barClass = score >= 75 ? "bg-success" : score >= 50 ? "bg-warning" : "bg-danger";
                            <div class="mb-2">
                                <div class="progress rounded-pill" style="height: 20px;">
                                    <div class="progress-bar @barClass" style="width: @score%" role="progressbar">
                                        @score%
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-1">Último score de cumplimiento</small>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted"><small>Sin auditorías completadas</small></p>
                        }
                    </div>

                    <div class="card-footer bg-light d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@provider.Id" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        <a asp-action="Edit" asp-route-id="@provider.Id" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@provider.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash3"></i> Eliminar
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Mensaje sin registros -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 rounded-4 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> No hay proveedores registrados.
            <a asp-action="Create" class="fw-semibold text-primary">Crea el primero</a>.
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
