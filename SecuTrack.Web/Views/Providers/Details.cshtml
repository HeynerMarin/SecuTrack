@model SecuTrack.Application.DTOs.ProviderDto

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="bi bi-building me-2"></i>Detalles del Proveedor</h3>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold text-secondary">Nombre</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 fw-bold text-secondary">Tipo</dt>
                <dd class="col-sm-9">@Model.Type</dd>

                <dt class="col-sm-3 fw-bold text-secondary">Región</dt>
                <dd class="col-sm-9">@Model.Region</dd>

                <dt class="col-sm-3 fw-bold text-secondary">Descripción</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3 fw-bold text-secondary">Correo de Contacto</dt>
                <dd class="col-sm-9">@Model.ContactEmail</dd>

                <dt class="col-sm-3 fw-bold text-secondary">Sitio Web</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                    {
                        <a href="@Model.WebsiteUrl" target="_blank" class="text-decoration-none">
                            <i class="bi bi-globe me-1"></i>@Model.WebsiteUrl
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No especificado</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="card mt-5 shadow-sm border-0">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Auditorías Asociadas</h4>
        </div>

        <div class="card-body">
            @if (ViewBag.Audits != null && ViewBag.Audits.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Auditor</th>
                                <th>Fecha</th>
                                <th>Versión</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var audit in ViewBag.Audits)
                            {
                                <tr>
                                    <td>@audit.AuditorName</td>
                                    <td>@audit.AuditDate.ToShortDateString()</td>
                                    <td>@audit.AuditVersion</td>
                                    <td>
                                        <span class="badge @(audit.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                            @(audit.IsCompleted ? "Completada" : "En progreso")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Audits" asp-action="Details" asp-route-id="@audit.Id" class="btn btn-outline-info btn-sm me-1">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        <a asp-controller="Audits" asp-action="Evaluate" asp-route-id="@audit.Id" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-pencil-square"></i> Evaluar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-secondary text-center mb-0">
                    <i class="bi bi-exclamation-circle me-2"></i>No hay auditorías asociadas a este proveedor.
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
            <i class="bi bi-trash"></i> Eliminar
        </a>
    </div>
</div>
