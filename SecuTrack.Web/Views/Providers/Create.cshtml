@model SecuTrack.Application.DTOs.CreateProviderDto

@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-secutrack text-white">
                    <h3 class="mb-0"><i class="bi bi-cloud-plus"></i> Nuevo Proveedor Cloud</h3>
                </div>
                <div class="card-body bg-light-secutrack">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Ej: Amazon Web Services" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label fw-semibold"></label>
                            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<SecuTrack.Core.Enums.ProviderType>()">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Region" class="form-label fw-semibold"></label>
                            <input asp-for="Region" class="form-control" placeholder="Ej: Global, US-East, EU-West" />
                            <span asp-validation-for="Region" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descripción del proveedor y sus servicios..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactEmail" class="form-label fw-semibold"></label>
                            <input asp-for="ContactEmail" class="form-control" type="email" placeholder="Ej: contacto@proveedor.com" />
                            <span asp-validation-for="ContactEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="WebsiteUrl" class="form-label fw-semibold"></label>
                            <input asp-for="WebsiteUrl" class="form-control" type="url" placeholder="https://www.proveedor.com" />
                            <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left-circle"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save2"></i> Crear Proveedor
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
